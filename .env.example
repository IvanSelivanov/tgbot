# Скопируй в .env и заполни. .env* в .gitignore и .vercelignore.
# Локальный запуск: node --env-file=.env bot.js

# Токен от @BotFather
BOT_TOKEN=

# Ключ из AI Studio. Заводи в отдельном проекте, где billing не включён,
# иначе он может тихо уехать с бесплатного тарифа.
GEMINI_API_KEY=

# Числовой user_id (у @userinfobot) ИЛИ @username. Можно вперемешку.
#
# ЕСЛИ ЗНАЧЕНИЙ НЕСКОЛЬКО — БЕРИ В КАВЫЧКИ:
#   ALLOWED_USER_IDS="123456789, @ivselivanov"
# Без кавычек пробел после запятой ломает разбор в шелле: переменная
# оказывается пустой, whitelist никого не пускает, и бот молча игнорирует
# всё. node --env-file читает и без кавычек, а вот `. ./.env` — нет.
# Числовой надёжнее: он неизменен, а username можно сменить, и освободившийся
# займёт кто-то другой. При входе по username бот печатает числовой id в лог.
ALLOWED_USER_IDS=

# Произвольная строка. Передаётся в setWebhook как secret_token и
# проверяется в api/index.js. Локальному полингу не нужна.
WEBHOOK_SECRET=

# Проверено 2026-08-01: русская речь из OGG/Opus расшифровывается отлично.
# flash-lite выбран ради квоты — 500 запросов в день.
GEMINI_MODEL=gemini-3.1-flash-lite

# Порог длины голосовухи в секундах. Благодаря waitUntil он больше не
# упирается в таймаут вебхука Telegram — только в maxDuration (300 с)
# и лимиты Gemini.
MAX_VOICE_SECONDS=600

# Короче этого саммари не добавляется.
SUMMARY_THRESHOLD_SECONDS=60
