# Скопируй в .env и заполни. .env* в .gitignore и .vercelignore.

# Токен от @BotFather
BOT_TOKEN=

# Ключ из AI Studio. Заводи в отдельном проекте, где billing не включён.
GEMINI_API_KEY=

# Свой user_id узнать у @userinfobot. Несколько — через запятую.
ALLOWED_USER_IDS=

# Произвольная строка. Передаётся в setWebhook как secret_token и
# проверяется в api/index.rb. Локальному полингу не нужна.
WEBHOOK_SECRET=

# Open Question 5: gemini-2.5-flash устарел, 2.0-flash выключен.
# Сверь актуальное имя в AI Studio перед первым запуском.
GEMINI_MODEL=gemini-3.5-flash

# Порог длины голосовухи в секундах. 180 при потолке функции 300 с.
# Если Этап 0 покажет потолок 60 с — ставь 120.
MAX_VOICE_SECONDS=180

# Короче этого саммари не добавляется.
SUMMARY_THRESHOLD_SECONDS=60
